# LegalVault AI — backend environment template
# Copy to `.env` and fill in real values. NEVER commit `.env` to git.
# The real `.env` is in .gitignore. If a secret ever lands in a commit,
# rotate it FIRST, then follow the incident procedure in docs/RULES.md.

# ─── Runtime ──────────────────────────────────────────────────────
ENV=dev                              # dev | staging | prod
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ─── Model tier (Task 4.2) ────────────────────────────────────────
# 1 = Qwen3-30B (GPU workstation)
# 2 = Phi-4 Q4 (office laptop, default)
# 3 = Llama 3.2 3B (low-RAM devices)
MODEL_TIER=2

# ─── Ollama (Task 4.1) ────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_SEC=60

# ─── Vector store (Task 2.2) ──────────────────────────────────────
VECTOR_STORE=qdrant                  # qdrant | pgvector
QDRANT_PATH=./data/qdrant            # embedded mode — path on local disk

# ─── Postgres (Task 6.1) ──────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://legalvault:legalvault@localhost:5432/legalvault

# ─── Redis (Task 9.3) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth (Task 6.4) ──────────────────────────────────────────────
# GENERATE a strong random secret in production. Never reuse across envs.
# `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET=change-me-generate-a-strong-random-secret
JWT_EXPIRY_HOURS=8
REFRESH_TOKEN_EXPIRY_DAYS=30

# ─── Rate limiting (TRD §12.5) ────────────────────────────────────
RATE_LIMIT_PER_USER_PER_MIN=30
RATE_LIMIT_PER_ORG_PER_HOUR=500

# ─── Storage ──────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=./data/documents
MAX_UPLOAD_MB=50
